<Window x:Class="StayAwake.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:StayAwake.Models"
        Title="{DynamicResource AppTitle}"
        Height="620" Width="440"
        MinHeight="520" MinWidth="400"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Bottom"
               Text="{DynamicResource Copyright}"
               Foreground="{DynamicResource MutedBrush}"
               FontSize="11"
               HorizontalAlignment="Center"
               Margin="0,10,0,0"/>

    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <Button Content="{DynamicResource Settings}" Style="{StaticResource GhostButton}"
                Click="Settings_Click" Margin="0,0,8,0"/>
        <Button Content="{DynamicResource Toggle}" Style="{StaticResource GhostButton}"
                Command="{Binding ToggleAwakeCommand}" Margin="0,0,8,0"/>
        <Button Style="{StaticResource PrimaryButton}" Command="{Binding TogglePauseCommand}">
          <TextBlock>
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Text" Value="{DynamicResource Pause}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsPaused}" Value="True">
                    <Setter Property="Text" Value="{DynamicResource Resume}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Button>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="StayAwake" FontSize="22" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}"/>
        <TextBlock Text="{Binding StatusText}" FontSize="14"
                   Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
      </StackPanel>
    </DockPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="MainScroll">
      <StackPanel>
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,12"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource Status}" Foreground="{DynamicResource MutedBrush}"/>
            <TextBlock Grid.Column="1" Text="{DynamicResource Battery}" Foreground="{DynamicResource MutedBrush}"
                       HorizontalAlignment="Right"/>
            <TextBlock Grid.Row="1" Text="{Binding ReasonsText}" TextWrapping="Wrap" Margin="0,4,8,0"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BatteryText}"
                       HorizontalAlignment="Right" Margin="0,4,0,0"/>
            <TextBlock Grid.Row="2" Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}">
              <Run Text="{DynamicResource Remaining}"/>
              <Run Text=": "/>
              <Run Text="{Binding RemainingText, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Grid.Row="3" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}">
              <Run Text="{DynamicResource EndsAt}"/>
              <Run Text=": "/>
              <Run Text="{Binding EndsAtText, Mode=OneWay}"/>
            </TextBlock>
          </Grid>
        </Border>

        <DockPanel Margin="0,0,0,10">
          <TextBlock Text="{DynamicResource Profiles}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <Button DockPanel.Dock="Right" Content="{DynamicResource Apply}" Style="{StaticResource PrimaryButton}"
                  Command="{Binding ApplyProfileCommand}" Margin="8,0,0,0" Padding="10,4"/>
          <ComboBox ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfileName}"/>
        </DockPanel>

        <TextBlock Text="{DynamicResource Mode}" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" Margin="0,0,0,8"/>

        <CheckBox Content="{DynamicResource KeepDisplay}" IsChecked="{Binding KeepDisplayOn}" Margin="0,0,0,12"/>

        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
          <StackPanel>
            <TextBlock Text="{DynamicResource ModeTimed}" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <DockPanel Margin="0,0,0,6">
              <TextBlock Text="{DynamicResource Preset}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <ComboBox ItemsSource="{Binding TimerPresets}" SelectedItem="{Binding SelectedPresetMinutes}"/>
            </DockPanel>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="{DynamicResource Apply}" Style="{StaticResource PrimaryButton}"
                      Command="{Binding ApplyTimedCommand}" Margin="8,0,0,0"/>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource TimedMinutes}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Width="80" Text="{Binding TimedMinutes, UpdateSourceTrigger=PropertyChanged}"/>
              </StackPanel>
            </DockPanel>
          </StackPanel>
        </Border>

        <Border x:Name="UntilSection" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
          <StackPanel>
            <TextBlock Text="{DynamicResource ModeUntil}" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="{DynamicResource Apply}" Style="{StaticResource PrimaryButton}"
                      Command="{Binding ApplyUntilCommand}" Margin="8,0,0,0"/>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource UntilTime}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Width="80" Text="{Binding UntilTime, UpdateSourceTrigger=PropertyChanged}"/>
              </StackPanel>
            </DockPanel>
          </StackPanel>
        </Border>

        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
          <StackPanel>
            <DockPanel Margin="0,0,0,8">
              <TextBlock Text="{DynamicResource Rules}" FontWeight="SemiBold"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource PickProcess}" Style="{StaticResource GhostButton}"
                        Command="{Binding PickProcessCommand}" Margin="0,0,8,0" Padding="8,4"/>
                <TextBlock Text="{DynamicResource RuleLogic}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Width="90" ItemsSource="{Binding RuleLogics}" SelectedItem="{Binding RuleLogic}"/>
              </StackPanel>
            </DockPanel>
            <CheckBox Content="{DynamicResource ProcessRule}" IsChecked="{Binding ProcessRuleEnabled}"/>
            <CheckBox IsChecked="{Binding CpuRuleEnabled}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource CpuRule}" Margin="0,0,8,0"/>
                <TextBox Width="50" Text="{Binding CpuThreshold, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="%" Margin="4,0,0,0"/>
              </StackPanel>
            </CheckBox>
            <CheckBox IsChecked="{Binding NetworkRuleEnabled}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource NetworkRule}" Margin="0,0,8,0"/>
                <TextBox Width="60" Text="{Binding NetworkThresholdKb, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="KB/s" Margin="4,0,0,0"/>
              </StackPanel>
            </CheckBox>
            <CheckBox Content="{DynamicResource ScheduleRule}" IsChecked="{Binding ScheduleRuleEnabled}"/>

            <ItemsControl ItemsSource="{Binding RuleResults}" Margin="0,8,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:RuleResult}">
                  <TextBlock Margin="0,2" Foreground="{DynamicResource MutedBrush}">
                    <Run Text="{Binding Description, Mode=OneWay}"/>
                    <Run Text=" — "/>
                    <Run Text="{Binding OptionalDetails, Mode=OneWay}"/>
                  </TextBlock>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <TextBlock Text="{DynamicResource Events}" FontWeight="SemiBold" Margin="0,4,0,6"/>
        <ItemsControl ItemsSource="{Binding Events}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type models:EventLogEntry}">
              <TextBlock Margin="0,2" FontSize="11" Foreground="{DynamicResource MutedBrush}">
                <Run Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}, Mode=OneWay}"/>
                <Run Text=" ["/>
                <Run Text="{Binding Category, Mode=OneWay}"/>
                <Run Text="] "/>
                <Run Text="{Binding Message, Mode=OneWay}"/>
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
