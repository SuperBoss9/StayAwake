<Window x:Class="StayAwake.Views.ProcessPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource PickProcess}"
        Height="480" Width="420"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <Button DockPanel.Dock="Right" Content="{DynamicResource Refresh}" Style="{StaticResource GhostButton}"
              Command="{Binding RefreshCommand}" Margin="8,0,0,0" Padding="10,4"/>
      <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"/>
    </DockPanel>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <DockPanel Margin="0,0,0,8">
        <TextBlock Text="Name:" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox Text="{Binding ManualName, UpdateSourceTrigger=PropertyChanged}"/>
      </DockPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{DynamicResource Cancel}" Style="{StaticResource GhostButton}"
                Click="Cancel_Click" Margin="0,0,8,0" Padding="14,6"/>
        <Button Content="{DynamicResource Confirm}" Style="{StaticResource PrimaryButton}"
                Command="{Binding ConfirmSelectedCommand}" Click="Confirm_Click" Padding="14,6"/>
      </StackPanel>
    </StackPanel>

    <ListBox ItemsSource="{Binding Filtered}" SelectedItem="{Binding Selected}"
             DisplayMemberPath="Display"/>
  </DockPanel>
</Window>
