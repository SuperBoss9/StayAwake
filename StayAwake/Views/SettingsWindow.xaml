<Window x:Class="StayAwake.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:StayAwake.Views"
        Title="{DynamicResource Settings}"
        Height="640" Width="520"
        MinHeight="500" MinWidth="460"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <views:TimeSpanToStringConverter x:Key="TimeSpanConv"/>
  </Window.Resources>
  <DockPanel Margin="16">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
      <TextBlock Text="{DynamicResource Copyright}"
                 Foreground="{DynamicResource MutedBrush}"
                 FontSize="11"
                 VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
        <Button Content="{DynamicResource Cancel}" Style="{StaticResource GhostButton}"
                Click="Cancel_Click" Margin="0,0,8,0" Padding="16,6"/>
        <Button Content="{DynamicResource Save}" Style="{StaticResource PrimaryButton}"
                Command="{Binding SaveCommand}" Click="Save_Click" Padding="16,6"/>
      </StackPanel>
    </DockPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="{DynamicResource Profiles}" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <DockPanel Margin="0,0,0,12">
          <Button DockPanel.Dock="Right" Content="{DynamicResource Apply}" Style="{StaticResource PrimaryButton}"
                  Command="{Binding ApplyProfileCommand}" Margin="8,0,0,0" Padding="10,4"/>
          <ComboBox ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfileName}"/>
        </DockPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
          <Button Content="{DynamicResource Export}" Style="{StaticResource GhostButton}"
                  Command="{Binding ExportSettingsCommand}" Margin="0,0,8,0" Padding="12,6"/>
          <Button Content="{DynamicResource Import}" Style="{StaticResource GhostButton}"
                  Command="{Binding ImportSettingsCommand}" Padding="12,6"/>
        </StackPanel>

        <TextBlock Text="{DynamicResource Battery}" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <CheckBox Content="{DynamicResource AllowOnBattery}" IsChecked="{Binding AllowOnBattery}"/>
        <CheckBox Content="{DynamicResource DisableBelow}" IsChecked="{Binding DisableBelowBattery}"/>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
          <TextBlock Text="%" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox Width="60" Text="{Binding BatteryCutoff, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <TextBlock Text="{DynamicResource Theme}" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding ThemeMode}" Margin="0,0,0,8"/>
        <TextBlock Text="{DynamicResource Language}" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" Margin="0,0,0,12"/>

        <CheckBox Content="{DynamicResource StartWithWindows}" IsChecked="{Binding StartWithWindows}"/>
        <CheckBox Content="{DynamicResource StartMinimized}" IsChecked="{Binding StartMinimized}"/>
        <CheckBox Content="{DynamicResource CloseToTray}" IsChecked="{Binding CloseToTray}"/>
        <CheckBox Content="{DynamicResource Notifications}" IsChecked="{Binding ShowNotifications}" Margin="0,0,0,8"/>
        <CheckBox Content="{DynamicResource TimerWarning}" IsChecked="{Binding TimerWarningEnabled}"/>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
          <TextBlock Text="{DynamicResource TimerWarningMinutes}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ComboBox Width="80" ItemsSource="{Binding WarningMinuteOptions}" SelectedItem="{Binding TimerWarningMinutes}"/>
        </StackPanel>

        <TextBlock Text="{DynamicResource Hotkeys}" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <CheckBox Content="{DynamicResource Hotkeys}" IsChecked="{Binding HotkeysEnabled}"/>
        <Grid Margin="0,4,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <TextBlock Text="{DynamicResource ToggleHotkey}" VerticalAlignment="Center"/>
          <TextBox Grid.Column="1" Text="{Binding ToggleHotkey, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Grid.Row="1" Text="{DynamicResource DisplayHotkey}" VerticalAlignment="Center" Margin="0,6,0,0"/>
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DisplayHotkey, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
        </Grid>
        <TextBlock Text="{Binding HotkeyStatus}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>

        <TextBlock Text="{DynamicResource GraceSeconds}" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <TextBlock Text="CPU" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox Width="50" Text="{Binding CpuGraceSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0"/>
          <TextBlock Text="Net" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox Width="50" Text="{Binding NetworkGraceSeconds, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
          <TextBlock Text="{DynamicResource PollSeconds}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Text="CPU" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox Width="40" Text="{Binding CpuPollSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0"/>
          <TextBlock Text="Net" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox Width="40" Text="{Binding NetworkPollSeconds, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <TextBlock Text="{DynamicResource LaunchUnderAwake}" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <DockPanel Margin="0,0,0,12">
          <Button DockPanel.Dock="Right" Content="{DynamicResource Apply}" Style="{StaticResource PrimaryButton}"
                  Command="{Binding LaunchUnderAwakeCommand}" Margin="8,0,0,0"/>
          <Button DockPanel.Dock="Right" Content="{DynamicResource Browse}" Style="{StaticResource GhostButton}"
                  Command="{Binding BrowseLaunchCommand}" Margin="8,0,0,0"/>
          <TextBox Text="{Binding LaunchCommand, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>

        <DockPanel Margin="0,0,0,6">
          <TextBlock Text="{DynamicResource ProcessRules}" FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource PickProcess}" Style="{StaticResource GhostButton}"
                    Click="PickProcess_Click" Margin="0,0,8,0" Padding="10,4"/>
            <Button Content="{DynamicResource Add}" Style="{StaticResource GhostButton}"
                    Command="{Binding AddProcessRuleCommand}" Padding="10,4"/>
          </StackPanel>
        </DockPanel>
        <ItemsControl ItemsSource="{Binding ProcessRules}" Margin="0,0,0,12">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="0,4">
                <Button DockPanel.Dock="Right" Content="{DynamicResource Remove}" Style="{StaticResource GhostButton}"
                        Command="{Binding DataContext.RemoveProcessRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" Padding="8,2"/>
                <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}"/>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <DockPanel Margin="0,0,0,6">
          <TextBlock Text="{DynamicResource ScheduleRules}" FontWeight="SemiBold"/>
          <Button HorizontalAlignment="Right" Content="{DynamicResource Add}" Style="{StaticResource GhostButton}"
                  Command="{Binding AddScheduleRuleCommand}" Padding="10,4"/>
        </DockPanel>
        <ItemsControl ItemsSource="{Binding ScheduleRules}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                      Padding="8" Margin="0,0,0,8">
                <StackPanel>
                  <DockPanel>
                    <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button DockPanel.Dock="Right" Content="{DynamicResource Remove}" Style="{StaticResource GhostButton}"
                            Command="{Binding DataContext.RemoveScheduleRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" Padding="8,2"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                  </DockPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Start" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Width="70" Text="{Binding StartTime, Converter={StaticResource TimeSpanConv}, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Text="End" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <TextBox Width="70" Text="{Binding EndTime, Converter={StaticResource TimeSpanConv}, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Text="Days mask" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <TextBox Width="70" Text="{Binding DaysOfWeek, UpdateSourceTrigger=PropertyChanged}"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{DynamicResource Advanced}" FontWeight="SemiBold" Margin="0,8,0,6"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Button Content="{DynamicResource OpenLogs}" Style="{StaticResource GhostButton}"
                  Command="{Binding OpenLogsFolderCommand}" Margin="0,0,8,0" Padding="10,4"/>
          <Button Content="{DynamicResource OpenSettingsFolder}" Style="{StaticResource GhostButton}"
                  Command="{Binding OpenSettingsFolderCommand}" Margin="0,0,8,0" Padding="10,4"/>
          <Button Content="{DynamicResource ResetSettings}" Style="{StaticResource GhostButton}"
                  Command="{Binding ResetSettingsCommand}" Padding="10,4"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
